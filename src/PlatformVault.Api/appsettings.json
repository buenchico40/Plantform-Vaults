{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "System": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/platformvault-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },
  "KeyProtection": {
    "StoreLocation": "LocalMachine",
    "ActiveThumbprint": "",
    "PreviousThumbprints": []
  },
  "ApiClients": {
    "Clients": []
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "From": ""
  },
  "Jobs": {
    "Enabled": true
  },
  "Security": {
    "LoginAttemptsPerMinutePerClient": 20
  }
}
