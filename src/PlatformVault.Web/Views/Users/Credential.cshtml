@model (string UserName, string TemporaryPassword)
@{ ViewData["Title"] = "Contraseña temporal"; }
<div class="pv-card pv-login">
    <h1>Contraseña temporal</h1>
    <p>Entregue esta contraseña a <b>@Model.UserName</b> por un canal seguro. Se muestra una sola vez y debe cambiarse en el primer inicio de sesión.</p>
    <p><input type="text" class="pv-reveal-output" value="@Model.TemporaryPassword" readonly autocomplete="off" /></p>
    <a asp-action="Index">Volver a usuarios</a>
</div>
