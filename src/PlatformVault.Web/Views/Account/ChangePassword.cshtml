@model ChangePasswordForm
@{ ViewData["Title"] = "Cambiar contraseña"; }
<div class="pv-card pv-login">
    <h1>Cambiar contraseña</h1>
    @if (User.HasClaim(WebClaims.MustChangePassword, "true"))
    {
        <p class="pv-msg pv-err">Su contraseña es temporal o caducó (90 días). Debe cambiarla para continuar.</p>
    }
    <form asp-action="ChangePassword" method="post" autocomplete="off">
        <div asp-validation-summary="All" class="pv-err"></div>
        <label class="pv-field">Contraseña actual <input asp-for="CurrentPassword" autocomplete="current-password" /></label>
        <label class="pv-field">Nueva contraseña <input asp-for="NewPassword" autocomplete="new-password" /></label>
        <label class="pv-field">Confirmación <input asp-for="ConfirmPassword" autocomplete="new-password" /></label>
        <p class="pv-muted">Mínimo 15 caracteres con mayúsculas, minúsculas, dígitos y símbolos. No puede repetir sus últimas 4 contraseñas.</p>
        <p><button type="submit">Guardar</button></p>
    </form>
</div>
