@{
    var user = Context.User;
    var signedIn = user.Identity?.IsAuthenticated == true && !user.HasClaim(WebClaims.MustChangePassword, "true");
    var afToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="pv-af" content="@afToken" />
    <title>@ViewData["Title"] · PlatformVault</title>
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.fluent.blue.light.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/devextreme/js/jquery.min.js"></script>
    <script src="~/lib/devextreme/js/dx.all.js"></script>
    <script src="~/lib/devextreme/js/dx.messages.es.js"></script>
    <script src="~/lib/devextreme/js/dx.aspnet.mvc.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>
<body>
    @Html.DevExtreme().AddCspNonce(Csp.Nonce(Context))
    <header class="pv-header">
        <a class="pv-brand" asp-controller="Home" asp-action="Index">PlatformVault</a>
        @if (signedIn)
        {
            <nav class="pv-nav">
                <a asp-controller="Home" asp-action="Index">Tablero</a>
                <a asp-controller="Objects" asp-action="Index">Inventario</a>
                <a asp-controller="Access" asp-action="Index">Solicitudes y accesos</a>
                <a asp-controller="Groups" asp-action="Index">Grupos</a>
                @if (user.Can("ViewAlerts"))
                {
                    <a asp-controller="Alerts" asp-action="Index">Alertas</a>
                    <a asp-controller="Alerts" asp-action="Policies">Políticas</a>
                }
                @if (user.Can("VerifyAuditChain"))
                {
                    <a asp-controller="Audit" asp-action="Index">Auditoría</a>
                }
                @if (user.Can("ManageUsers"))
                {
                    <a asp-controller="Users" asp-action="Index">Usuarios</a>
                }
            </nav>
        }
        @if (user.Identity?.IsAuthenticated == true)
        {
            <form class="pv-user" asp-controller="Account" asp-action="Logout" method="post">
                <span>@user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                <span class="pv-roles">@string.Join(", ", user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(r => r.Value))</span>
                <a asp-controller="Account" asp-action="ChangePassword">Cambiar contraseña</a>
                <button type="submit" class="pv-link">Salir</button>
            </form>
        }
    </header>
    <main class="pv-main">
        @if (TempData["Info"] is string info)
        {
            <div class="pv-msg pv-ok">@info</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="pv-msg pv-err">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="pv-footer">PlatformVault · Fase 1 · Los valores sensibles nunca se muestran en listados ni se guardan en el navegador.</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
